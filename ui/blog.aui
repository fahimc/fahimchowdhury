def ArticleCard type title summary href
  Card
    Badge $type
    Heading level=2 $title
    Text $summary
    Link href=$href "Read article"

Page FahimBlog
  Stack gap=lg
    Section
      Badge "Notes from the edge of useful"
      Heading level=1 "Insights"
      Text "Ideas about AI, product, and the choices that make new technology feel human."
